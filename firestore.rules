// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: garages
// Document ID: garageId
// Fields:
//   - name: string (required)
//   - phone: string (required)
//   - hourlyRate: number (required)
//   - overnightRate: number (required)
//   - subscriptionExpiry: timestamp (required)
//   - createdAt: timestamp (required)
//   - subscriptionDays: number (required)
//   - billingModel: string ('subscription' | 'commission') (optional)
//   - commissionPerVehicle: number (optional)
//   - monthlySubscriptionFee: number (optional)
//   - balance: number (optional)
//   - isLocked: bool (optional)
//   - lastSubscriptionDeduction: timestamp (optional)
//   - lastPaidFriday: string (optional)
//
// Collection: garages/{garageId}/vehicles
// Document ID: vehicleId
// Fields:
//   - plateNumber: string (required)
//   - plateNumberRaw: string (required)
//   - entryTime: timestamp (required)
//   - exitTime: timestamp (optional)
//   - type: string ('hourly' | 'overnight') (required)
//   - garageId: string (required)
//   - status: string ('inside' | 'outside') (required)
//   - totalCost: number (optional)
//
// Collection: staff
// Document ID: staffId
// Fields:
//   - name: string (required)
//   - phone: string (required)
//   - garageId: string (required)
//   - role: string ('staff') (required)
//   - currentSessionId: string (optional)
//
// Collection: activity_logs
// Document ID: logId
// Fields:
//   - garageId: string (required)
//   - staffId: string (optional)
//   - staffName: string (required)
//   - actionType: string ('check_in' | 'check_out') (required)
//   - plateNumber: string (required)
//   - timestamp: timestamp (required)
//
// Collection: delegates
// Document ID: delegateId
// Fields:
//   - name: string (required)
//   - phone: string (required)
//   - pin: string (required)
//   - role: string ('delegate') (required)
//   - currentSessionId: string (optional)
//   - createdAt: timestamp (required)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Deny & Catch-All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // ===============================================================
    // Zero-Trust Cryptographic Session Matching Helpers
    // ===============================================================

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_sessions/$(request.auth.uid));
    }

    function isAdminPin(pin) {
      return pin is string && (
        (!exists(/databases/$(database)/documents/admin_settings/auth_pin) && pin == '8899') ||
        (exists(/databases/$(database)/documents/admin_settings/auth_pin) && pin == get(/databases/$(database)/documents/admin_settings/auth_pin).data.pin)
      );
    }

    function isSupervisor() {
      return isSignedIn() && exists(/databases/$(database)/documents/supervisor_sessions/$(request.auth.uid));
    }

    function isDelegate() {
      return isSignedIn() && exists(/databases/$(database)/documents/delegate_sessions/$(request.auth.uid));
    }

    function isGeneralManager() {
      return isSignedIn() && exists(/databases/$(database)/documents/general_manager_sessions/$(request.auth.uid));
    }

    function isGarageSession(garageId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/garage_sessions/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/garage_sessions/$(request.auth.uid)).data.garageId == garageId) ||
        (exists(/databases/$(database)/documents/staff_sessions/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/staff_sessions/$(request.auth.uid)).data.garageId == garageId)
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Verification Schema Rules
    // ===============================================================

    function isValidGarage(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && (data.phone.size() == 0 || (data.phone.size() >= 3 && data.phone.size() <= 20)) &&
             data.hourlyRate is number && data.hourlyRate >= 0 &&
             data.overnightRate is number && data.overnightRate >= 0 &&
             data.createdAt is timestamp &&
             (data.billingModel == 'commission' || data.billingModel == 'subscription') &&
             data.pin is string && data.pin.size() >= 4 &&
             (!('currentSessionId' in data) || (data.currentSessionId is string && data.currentSessionId.size() <= 128)) &&
             (!('commissionPerVehicle' in data) || (data.commissionPerVehicle is number && data.commissionPerVehicle >= 0)) &&
             (!('balance' in data) || data.balance is number) &&
             (!('isLocked' in data) || data.isLocked is bool) &&
             (!('dailyRefundCount' in data) || data.dailyRefundCount is number) &&
             (!('lastRefundDate' in data) || data.lastRefundDate is string) &&
             (!('recentExits' in data) || data.recentExits is list) &&
             (!('lastTransactionDate' in data) || data.lastTransactionDate is string) &&
             (!('lastRechargeDate' in data) || data.lastRechargeDate is timestamp) &&
             (!('activePlates' in data) || data.activePlates is map);
    }

    function isGarageUpdateValid(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0)) &&
             (!('phone' in data) || (data.phone is string && (data.phone.size() == 0 || data.phone.size() >= 3))) &&
             (!('hourlyRate' in data) || data.hourlyRate is number) &&
             (!('overnightRate' in data) || data.overnightRate is number) &&
             (!('balance' in data) || data.balance is number) &&
             (!('isLocked' in data) || data.isLocked is bool) &&
             (!('activePlates' in data) || data.activePlates is map) &&
             (!('recentExits' in data) || data.recentExits is list) &&
             (!('lastTransactionDate' in data) || data.lastTransactionDate is string) &&
             (!('lastRechargeDate' in data) || data.lastRechargeDate is timestamp) &&
             (!('totalRevenue' in data) || data.totalRevenue is number) &&
             (!('totalVehiclesOut' in data) || data.totalVehiclesOut is number) &&
             (!('todayRevenue' in data) || data.todayRevenue is number) &&
             (!('todayCount' in data) || data.todayCount is number) &&
             (!('dailyRefundCount' in data) || data.dailyRefundCount is number) &&
             (!('lastRefundDate' in data) || data.lastRefundDate is string) &&
             (!('lastGiftMonth' in data) || data.lastGiftMonth is string) &&
             (!('currentSessionId' in data) || data.currentSessionId == null || (data.currentSessionId is string && data.currentSessionId.size() <= 128)) &&
             (!('shimmerColor' in data) || data.shimmerColor is string) &&
             (!('lastActive' in data) || data.lastActive == null || data.lastActive is timestamp);
    }

    function isValidVehicle(data) {
      return data.plateNumber is string && data.plateNumber.size() > 0 && data.plateNumber.size() <= 20 &&
             data.entryTime is timestamp &&
             data.type in ['hourly', 'overnight'] &&
             data.garageId is string && isValidId(data.garageId) &&
             data.status in ['inside', 'outside'] &&
             data.plateNumberRaw is string && data.plateNumberRaw.size() <= 20 &&
             (!('totalCost' in data) || (data.totalCost is number && data.totalCost >= 0)) &&
             (!('exitTime' in data) || data.exitTime is timestamp) &&
             (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100));
    }

    function isValidStaff(data) {
      return data.keys().hasAll(['name', 'garageId', 'role', 'pin']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 10 &&
             data.garageId is string && isValidId(data.garageId) &&
             data.role == 'staff' &&
             (!('currentSessionId' in data) || (data.currentSessionId is string && data.currentSessionId.size() <= 128));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['garageId', 'staffName', 'actionType', 'plateNumber', 'timestamp']) &&
             data.garageId is string && isValidId(data.garageId) &&
             data.staffName is string && data.staffName.size() <= 100 &&
             data.actionType in ['check_in', 'check_out', 'recharge', 'delete_refund', 'commission_payment'] &&
             data.plateNumber is string && data.plateNumber.size() <= 150 &&
             data.timestamp is timestamp &&
             (!('staffId' in data) || data.staffId == null || (data.staffId is string && isValidId(data.staffId))) &&
             (!('amount' in data) || data.amount is number) &&
             (!('packageId' in data) || data.packageId is string) &&
             (!('garageName' in data) || data.garageName is string);
    }

    function isValidDelegate(data) {
      return ('name' in data) && ('phone' in data) && ('pin' in data) && ('role' in data) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 20 &&
             data.pin is string && data.pin.size() >= 4 && data.pin.size() <= 10 &&
             data.role == 'delegate' &&
             (!('currentSessionId' in data) || (data.currentSessionId is string && data.currentSessionId.size() <= 128)) &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('canCreateGarage' in data) || data.canCreateGarage is bool) &&
             (!('commissionRate' in data) || data.commissionRate is number) &&
             (!('totalRechargedAmount' in data) || data.totalRechargedAmount is number) &&
             (!('lastSettledAt' in data) || data.lastSettledAt == null || data.lastSettledAt is timestamp);
    }

    function isValidSupervisor(data) {
      return ('name' in data) && ('phone' in data) && ('pin' in data) && ('role' in data) &&
             data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() >= 1 &&
             data.pin is string && data.pin.size() >= 4 &&
             data.role == 'supervisor';
    }

    function isValidGeneralManager(data) {
      return ('name' in data) && ('phone' in data) && ('pin' in data) && ('role' in data) &&
             data.name is string && data.name.size() > 0 &&
             data.phone is string && data.phone.size() >= 1 &&
             data.pin is string && data.pin.size() >= 4 &&
             data.role == 'general_manager';
    }

    function isValidRechargeRequest(data) {
      return data.keys().hasAll(['garageId', 'garageName', 'delegateId', 'delegateName', 'packageId', 'packageName', 'amount', 'carsCount', 'revenueAmount', 'status', 'createdAt']) &&
             data.garageId is string && isValidId(data.garageId) &&
             data.delegateId is string && isValidId(data.delegateId) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp &&
             data.amount is number &&
             data.carsCount is number &&
             data.revenueAmount is number;
    }

    function isValidTopupRequest(data) {
      return data.keys().hasAll(['garageId', 'garageName', 'packageName', 'amount', 'status', 'createdAt']) &&
             data.garageId is string && isValidId(data.garageId) &&
             data.garageName is string && data.garageName.size() <= 100 &&
             data.packageName is string && data.packageName.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'completed', 'cancelled'] &&
             data.createdAt is timestamp;
    }

    function isValidPackage(data) {
      return data.keys().hasAll(['name', 'price', 'vehiclesCount']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.vehiclesCount is number && data.vehiclesCount > 0;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['plateNumber', 'plateNumberRaw', 'ownerName', 'phone', 'startDate', 'endDate', 'garageId', 'createdAt']) &&
             data.plateNumber is string &&
             data.ownerName is string &&
             data.phone is string &&
             data.garageId is string &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Cryptographic Secure Sessions Mapping Rules
    // ===============================================================

    match /admin_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && isAdminPin(request.resource.data.pin);
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    match /admin_settings/{settingId} {
      allow get: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && !exists(/databases/$(database)/documents/admin_settings/auth_pin));
    }

    match /delegate_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && 
                              get(/databases/$(database)/documents/delegates/$(request.resource.data.delegateId)).data.pin == request.resource.data.pin;
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    match /supervisor_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && 
                              get(/databases/$(database)/documents/supervisors/$(request.resource.data.supervisorId)).data.pin == request.resource.data.pin;
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    match /general_manager_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && 
                              get(/databases/$(database)/documents/general_managers/$(request.resource.data.generalManagerId)).data.pin == request.resource.data.pin;
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    match /garage_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && 
                              (
                                get(/databases/$(database)/documents/garages/$(request.resource.data.garageId)).data.pin == request.resource.data.pin ||
                                get(/databases/$(database)/documents/garages/$(request.resource.data.garageId)).data.phone == request.resource.data.phone
                              );
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    match /staff_sessions/{sessionUid} {
      allow get: if isSignedIn() && sessionUid == request.auth.uid;
      allow create, update: if isSignedIn() && sessionUid == request.auth.uid && 
                              get(/databases/$(database)/documents/staff/$(request.resource.data.staffId)).data.pin == request.resource.data.pin;
      allow delete: if isSignedIn() && sessionUid == request.auth.uid;
    }

    // ===============================================================
    // Business Collection Rules
    // ===============================================================

    match /recharge_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isAdmin() || isSupervisor() || isDelegate();
      allow create: if (isDelegate() || isSupervisor()) && isValidRechargeRequest(incoming()) && isValidId(requestId);
      allow update: if (isAdmin() || isSupervisor()) && isValidId(requestId);
      allow delete: if (isAdmin() || isSupervisor()) && isValidId(requestId);
    }

    match /topup_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId);
      allow list: if isAdmin() || isSupervisor() || isDelegate() || isGarageSession(resource.data.garageId);
      allow create: if isSignedIn() && isValidTopupRequest(incoming()) && isValidId(requestId) && isGarageSession(incoming().garageId);
      allow update: if (isAdmin() || isSupervisor() || (isGarageSession(existing().garageId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']))) && isValidId(requestId);
      allow delete: if (isAdmin() || isSupervisor()) && isValidId(requestId);
    }

    match /packages/{packageId} {
      allow get: if isSignedIn() && isValidId(packageId);
      allow list: if isSignedIn();
      allow create: if isAdmin() && isValidPackage(incoming()) && isValidId(packageId);
      allow update: if isAdmin() && isValidPackage(incoming()) && isValidId(packageId);
      allow delete: if isAdmin() && isValidId(packageId);
    }

    match /test/connection {
      allow read: if true;
    }

    match /login_requests/{requestId} {
      allow get, list, create, update, delete: if isValidId(requestId);
    }

    match /activity_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (isAdmin() || isDelegate() || isSupervisor() || isGarageSession(resource.data.garageId));
      allow list: if isAdmin() || isDelegate() || isSupervisor() || isGarageSession(resource.data.garageId);
      allow create: if isSignedIn() && isValidActivityLog(incoming()) && isValidId(logId) && 
                    (isAdmin() || isDelegate() || isSupervisor() || isGarageSession(incoming().garageId));
      allow delete: if isAdmin() && isValidId(logId);
    }

    match /settings/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
      allow write: if isAdmin() && isValidId(docId);
    }

    match /supervisors/{supervisorId} {
      allow get: if isSignedIn() && isValidId(supervisorId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || (isSignedIn() && 'adminPin' in incoming() && isAdminPin(incoming().adminPin))) && isValidSupervisor(incoming()) && isValidId(supervisorId);
      allow update: if isValidId(supervisorId) && (
        isAdmin() || 
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['currentSessionId', 'lastActive']))
      );
      allow delete: if isAdmin() && isValidId(supervisorId);
    }

    match /general_managers/{generalManagerId} {
      allow get: if isSignedIn() && isValidId(generalManagerId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || isSignedIn() || (isSignedIn() && 'adminPin' in incoming() && isAdminPin(incoming().adminPin))) && isValidGeneralManager(incoming()) && isValidId(generalManagerId);
      allow update: if isValidId(generalManagerId) && (
        isAdmin() || 
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['currentSessionId', 'lastActive', 'pin']))
      );
      allow delete: if isAdmin() && isValidId(generalManagerId);
    }

    match /delegates/{delegateId} {
      allow get: if isSignedIn() && isValidId(delegateId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || isSupervisor() || (isSignedIn() && 'adminPin' in incoming() && isAdminPin(incoming().adminPin))) && isValidDelegate(incoming()) && isValidId(delegateId);
      allow update: if isValidId(delegateId) && (
        isAdmin() || 
        isSupervisor() ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['currentSessionId', 'lastActive', 'totalRechargedAmount']))
      );
      allow delete: if (isAdmin() || isSupervisor()) && isValidId(delegateId);
    }

    match /staff/{staffId} {
      allow get: if isSignedIn() && isValidId(staffId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || isGarageSession(incoming().garageId)) && isValidStaff(incoming()) && isValidId(staffId);
      allow update: if isValidId(staffId) && (
        isAdmin() || 
        isGarageSession(existing().garageId) || 
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['currentSessionId', 'lastActive']))
      );
      allow delete: if (isAdmin() || isGarageSession(existing().garageId)) && isValidId(staffId);
    }

    match /garages/{garageId} {
      allow get: if isSignedIn() && isValidId(garageId);
      allow list: if isSignedIn();
      allow create: if (isAdmin() || isDelegate() || isSupervisor()) && isValidId(garageId) && 
                      incoming().keys().hasAll(['name', 'phone', 'hourlyRate', 'overnightRate', 'createdAt', 'billingModel', 'pin']) &&
                      isValidGarage(incoming());
      allow delete: if (isAdmin() || isSupervisor()) && isValidId(garageId);
      
      // Detailed Update Logic
      allow update: if isValidId(garageId) && isSignedIn() && (
        isAdmin() || 
        isSupervisor() ||
        (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['currentSessionId', 'lastActive'])) ||
        // Delegate can update balance, totalAdminRevenue, isLocked etc
        (isDelegate() && incoming().diff(existing()).affectedKeys().hasAny(['balance', 'totalAdminRevenue', 'isLocked'])) ||
        // Standard garage update
        (isGarageSession(garageId) && isGarageUpdateValid(incoming()) && (
          // Secure balance: can only be increased by Admin or isDelegate, otherwise must be a decrease (for commission / checkout)
          // or a valid refund (increase bounded by commissionPerVehicle and dailyRefundCount limit of 5)
          !incoming().diff(existing()).affectedKeys().hasAny(['balance']) || 
          incoming().balance < existing().balance ||
          (
            incoming().balance <= existing().balance + (existing().commissionPerVehicle is number ? existing().commissionPerVehicle : 1.0) &&
            incoming().dailyRefundCount is number &&
            incoming().dailyRefundCount <= 5
          )
        ))
      );
      
      match /vehicles/{vehicleId} {
        allow get: if isSignedIn() && isValidId(vehicleId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
        allow list: if isSignedIn() && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
        allow create: if isSignedIn() && isValidId(vehicleId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate()) && 
                         !get(/databases/$(database)/documents/garages/$(garageId)).data.isLocked && 
                         get(/databases/$(database)/documents/garages/$(garageId)).data.balance >= 0 &&
                         incoming().keys().hasAll(['plateNumber', 'entryTime', 'type', 'garageId', 'status', 'plateNumberRaw']) &&
                         isValidVehicle(incoming());
        allow update: if isSignedIn() && isValidId(vehicleId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate()) && isValidVehicle(incoming());
        allow delete: if isSignedIn() && isValidId(vehicleId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
      }
 
      match /daily_stats/{dateId} {
        allow get: if isSignedIn() && isValidId(dateId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
        allow write, delete: if (isAdmin() || isSupervisor() || isDelegate() || isGarageSession(garageId)) && isValidId(dateId);
      }

      match /subscribers/{subscriberId} {
        allow get: if isSignedIn() && isValidId(subscriberId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
        allow list: if isSignedIn() && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
        allow create: if isSignedIn() && isValidId(subscriberId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate()) && isValidSubscriber(incoming());
        allow update: if isSignedIn() && isValidId(subscriberId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate()) && isValidSubscriber(incoming());
        allow delete: if isSignedIn() && isValidId(subscriberId) && (isGarageSession(garageId) || isAdmin() || isSupervisor() || isDelegate());
      }
    }
  }
}
